# 集中管理所有组件版本号，所有脚本通过 source 引用
# 修改前请确认兼容性（GPU Operator 与 K8s、containerd 之间）

# ---- Kubernetes ----
K8S_VERSION=v1.31.4
K8S_DEB_VERSION=1.31.4-1.1     # apt 包版本号格式
K8S_REPO_MINOR=v1.31           # pkgs.k8s.io 仓库小版本

# ---- 容器运行时 ----
CONTAINERD_VERSION=1.7.22
RUNC_VERSION=v1.2.1
CNI_PLUGINS_VERSION=v1.5.1
PAUSE_IMAGE=registry.k8s.io/pause:3.10

# ---- 网络与基础设施 ----
CALICO_VERSION=v3.28.2
CALICO_CHART_VERSION=v3.28.2   # tigera-operator chart 版本
METALLB_VERSION=v0.14.8
METALLB_CHART_VERSION=0.14.8
INGRESS_NGINX_VERSION=v1.11.3
INGRESS_NGINX_CHART_VERSION=4.11.3

# ---- 存储 ----
OPENEBS_VERSION=4.1.0
OPENEBS_CHART_VERSION=4.1.0

# ---- GPU ----
GPU_OPERATOR_VERSION=v25.3.0
GPU_OPERATOR_CHART_VERSION=v25.3.0
NVIDIA_DEVICE_PLUGIN_VERSION=v0.17.0
NVIDIA_GFD_VERSION=v0.17.0
NVIDIA_TOOLKIT_VERSION=v1.16.2-ubuntu20.04
NVIDIA_DCGM_VERSION=3.3.8-3.6.0-ubuntu22.04
# NFD 实际由 GPU Operator 25.3 拉取，版本是 v0.17.2（不是 0.16.4）
NFD_VERSION=v0.17.2

# ---- 工具 ----
HELM_VERSION=v3.16.2
MC_VERSION=RELEASE.2024-10-08T09-37-26Z
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z

# ---- 业务侧（首批镜像） ----
# v0.6.3.post1 不支持 Qwen3，必须 >= v0.8.5
# v0.11.0 用 CUDA 12.8（驱动 570 OK）
# v0.11.2 用 CUDA 12.9（驱动需升到 580）
VLLM_VERSION=v0.11.2

# ---- 模型 ----
MODEL_ID=qwen/Qwen3-8B
MODEL_DIR_NAME=Qwen3-8B
