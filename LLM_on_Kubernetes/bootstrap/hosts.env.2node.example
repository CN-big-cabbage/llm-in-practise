# 2 节点云部署：master + 1 worker，都在同一云内网，无需 Tailscale
# 复制为 hosts.env 使用

# ---- master：兼任 control-plane 和 GPU worker ----
MASTER_IP=10.0.0.10            # 改成 master 节点的云内网 IP
MASTER_HOST=k8s-master01
MASTER_ZONE=cloud
MASTER_HAS_GPU=true
MASTER_RUNS_MINIO=true         # MinIO 钉 master

# ---- worker：纯 GPU worker ----
NODE01_IP=10.0.0.11            # 改成 worker 节点的云内网 IP
NODE01_HOST=k8s-node01
NODE01_ZONE=cloud
NODE01_HAS_GPU=true

# 兼容 4 节点脚本，留空即可（脚本里有判空逻辑）
NODE02_IP=
NODE02_HOST=
NODE02_ZONE=
NODE02_HAS_GPU=
NODE03_IP=
NODE03_HOST=
NODE03_ZONE=
NODE03_HAS_GPU=

# ---- Calico ----
POD_CIDR=192.168.0.0/16
CALICO_MTU=1450                # 同云内网无 VPN，标准 MTU 即可

# ---- MetalLB（同一子网，单池就够）----
METALLB_CLOUD_RANGE=10.0.0.200-10.0.0.220   # 改成云内网未占用段
METALLB_LOCAL_RANGE=                         # 2 节点模式留空

# ---- MinIO 凭据 ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345

# ---- Tailscale（2 节点模式不用，留空）----
TAILSCALE_AUTHKEY=
