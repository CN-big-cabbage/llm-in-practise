# 复制为 hosts.env 并按实际情况填写
# 注意：混合架构下，所有 IP 都填 Tailscale 分配的 100.x.x.x 地址
# 跑完 cloud/00a-setup-tailscale.sh 后用 `tailscale status` 查看分配的 IP

# ---- master：本地虚拟机 ----
MASTER_IP=100.64.0.1
MASTER_HOST=k8s-master01
MASTER_ZONE=local              # local / cloud

# ---- node01：本地虚拟机（无 GPU，跑基础设施）----
NODE01_IP=100.64.0.2
NODE01_HOST=k8s-node01
NODE01_ZONE=local
NODE01_HAS_GPU=false

# ---- node02：云端 3090，同时跑 MinIO ----
NODE02_IP=100.64.0.3
NODE02_HOST=k8s-node02
NODE02_ZONE=cloud
NODE02_HAS_GPU=true
NODE02_RUNS_MINIO=true         # MinIO 钉在这个节点

# ---- node03：云端 3090 ----
NODE03_IP=100.64.0.4
NODE03_HOST=k8s-node03
NODE03_ZONE=cloud
NODE03_HAS_GPU=true

# ---- Calico Pod CIDR（必须与 kubeadm init 的 --pod-network-cidr 一致）----
POD_CIDR=192.168.0.0/16

# ---- MetalLB 地址池 ----
# 因为节点跨网，分两个池：
#   - 云端池：从云内网未占用段切，给推理 Service 用
#   - 本地池：从本地局域网未占用段切，给 Ingress 用
METALLB_CLOUD_RANGE=10.0.0.200-10.0.0.220     # 改成你云上未用的内网段
METALLB_LOCAL_RANGE=192.168.1.200-192.168.1.220 # 改成你本地局域网未用段

# ---- MinIO 凭据 ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345

# ---- Tailscale ----
# 在 https://login.tailscale.com/admin/settings/keys 生成 auth key
# 建议勾选：Reusable + Ephemeral=false + Pre-approved
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxx
